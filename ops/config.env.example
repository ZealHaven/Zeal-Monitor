# Copy to ops/config.env and adjust for your machine.
# Used by justfile/ops scripts (sourced when present).

# Network identity
TAILSCALE_IP=127.0.0.1
TAILNET_DOMAIN=local
PUBLIC_DOMAIN=example.com
