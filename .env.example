# Copy to .env and adjust for your machine.
# Monitor configuration (local-first defaults).

# Network
MONITORD_ADDR=127.0.0.1:9050
FRONTEND_PORT=9051
VITE_PORT=9065
OPENCODE_PORT=9060

# Paths
REPO_ROOT=.

# Chat LLM (optional — the Settings page writes MONITOR_CONFIG)
# MONITOR_CONFIG=/home/you/.config/monitor/config.json
# MONITOR_MODEL=opencode-go/beam-free
# Provider keys may also come from the environment (OpenCode reads these):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Tailnet / public (optional)
TAILSCALE_IP=127.0.0.1
TAILNET_DOMAIN=local
PUBLIC_DOMAIN=example.com

# CORS origin for the API ("*" for local SSR, or "-" to disable)
MONITOR_CORS_ORIGIN=*
